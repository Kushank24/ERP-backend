# Use postgresql+psycopg:// (not postgresql://) so SQLAlchemy uses psycopg v3.
# URL-encode special characters in the password (e.g. @ -> %40).
# TLS: sslmode=require is applied automatically for supabase.co / supabase.com hosts.
#
# Prefer the POOLER URI from Supabase (Settings → Database → Connection string):
#   host: aws-0-<REGION>.pooler.supabase.com
#   user: postgres.<project-ref>   (note the dot before the ref)
#   port: 6543 (transaction) or 5432 (session) — copy exactly from the dashboard
# Direct db.<ref>.supabase.co often fails DNS on IPv4-only networks; the pooler resolves on IPv4.
#
# Example (replace REGION, ref, password):
# DATABASE_URL=postgresql+psycopg://postgres.your_project_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-long-random-string
JWT_EXP_HOURS=24
CORS_ORIGINS=http://localhost:3000

# Required when the Next.js app uses Supabase Auth (Bearer = Supabase access token).
# Dashboard → Project Settings → API → JWT Settings → JWT Secret (not the anon key).
SUPABASE_JWT_SECRET=

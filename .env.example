# ═══════════════════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════════════════
# Use postgresql+psycopg:// (not postgresql://) so SQLAlchemy uses psycopg v3.
# URL-encode special characters in the password (e.g. @ -> %40).
# TLS: sslmode=require is applied automatically for supabase.co / supabase.com hosts.
#
# Prefer the POOLER URI from Supabase (Settings → Database → Connection string):
#   host: aws-0-<REGION>.pooler.supabase.com
#   user: postgres.<project-ref>   (note the dot before the ref)
#   port: 6543 (transaction) or 5432 (session) — copy exactly from the dashboard
# Direct db.<ref>.supabase.co often fails DNS on IPv4-only networks; the pooler resolves on IPv4.
#
# Example (replace REGION, ref, password):
# DATABASE_URL=postgresql+psycopg://postgres.your_project_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ═══════════════════════════════════════════════════════════════════════════
# Auth
# ═══════════════════════════════════════════════════════════════════════════
JWT_SECRET=replace-with-long-random-string
JWT_EXP_HOURS=24

# Comma-separated. MUST include the deployed frontend origin, or every browser
# request from it is blocked before it reaches a route.
#   CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Required when the Next.js app uses Supabase Auth (Bearer = Supabase access token).
# Dashboard → Project Settings → API → JWT Settings → JWT Secret (not the anon key).
SUPABASE_JWT_SECRET=

# Project URL, e.g. https://xxxx.supabase.co — used to verify ES256 tokens via JWKS.
SUPABASE_URL=

# Fallback role when an app_users row has no usable role. Keep least-privilege:
# authorization is enforced per module, so a permissive default grants real access.
SUPABASE_DEFAULT_ROLE=viewer

# ═══════════════════════════════════════════════════════════════════════════
# Email — provider selection
# ═══════════════════════════════════════════════════════════════════════════
#   resend → always the Resend HTTP API (use this in production)
#   smtp   → always raw SMTP (fine locally)
#   auto   → Resend if RESEND_API_KEY is set, else SMTP
EMAIL_PROVIDER=resend

# ── Resend ────────────────────────────────────────────────────────────────
# Must be set in the HOSTING environment, not only in this file. A key that
# exists locally and not on the host is the most common cause of "works on my
# machine" email failures.
RESEND_API_KEY=

# The From address. Its domain must be verified in Resend (DKIM + the send.
# subdomain records must resolve).
#
# SET THIS EXPLICITLY. If left blank it silently falls back to SMTP_USER, which
# happens to be correct locally and is usually NOT set on the host — producing
# an empty From and a Resend 422 that reads like a payload bug.
RESEND_FROM_EMAIL=

# Sent as the User-Agent to api.resend.com. Cloudflare fronts that API and
# returns 403 "error code: 1010" for client signatures it scores as automated;
# the previous value "esafe-erp/1.0" triggered exactly that in production.
# Overridable here so it can be tuned without a redeploy. Leave unset for the
# conventional default.
RESEND_USER_AGENT=

# ── SMTP (local dev, and the fallback transport) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Pause between messages. 2s ≈ 1800/hour. Raise if Resend returns 429.
SMTP_DELAY_SECONDS=2

# ═══════════════════════════════════════════════════════════════════════════
# Cloudinary — sales-order documents (invoice, e-way bill)
# ═══════════════════════════════════════════════════════════════════════════
# Dashboard → Settings → API Keys.
#
# REQUIRED ONE-TIME DASHBOARD STEP before this works at all:
#   Settings → Security → "Allow delivery of PDF and ZIP files"
# Free accounts block PDF *delivery* by default (separate from upload) as an
# anti-abuse measure. Without this, uploads succeed and every view 401s.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════════════════
# DEBUG | INFO | WARNING | ERROR. Default INFO.
# Use DEBUG for the first end-to-end email test: it logs the outbound Resend
# request (endpoint, from, recipient, payload size) and the full response.
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════
# Unused — declared but read by nothing. Left documented so it is not mistaken
# for a required setting. Campaign images are inlined as CID attachments from
# local disk, so no public base URL is involved.
# BASE_URL=
# ═══════════════════════════════════════════════════════════════════════════
